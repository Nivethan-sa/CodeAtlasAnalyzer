# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file - it's already in .gitignore.
#
# NOTE: you don't have to fill in JWT_SECRET/GITHUB_TOKEN here by hand -
# starting the server with neither set will show a one-time Setup screen
# in the browser that writes both into backend/.env for you.

# --- Database ------------------------------------------------------------
# MongoDB connection string. Defaults to a local instance on the standard
# port if unset - install MongoDB Community Server and run `mongod`, or
# point this at a free MongoDB Atlas cluster instead:
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=codeatlas

# --- Auth ------------------------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-string"

# --- Sign in with Google (optional) --------------------------------------------
# Adds a "Continue with Google" button to the sign-in / create-account screens.
# 1. https://console.cloud.google.com/apis/credentials -> Create credentials ->
#    OAuth client ID -> Application type: "Web application".
#    (If asked, first configure the OAuth consent screen: External, add your email.)
# 2. Under "Authorized JavaScript origins" add EXACTLY where you open the app,
#    e.g. http://localhost:5001  (and your https://your-domain.com when deployed).
# 3. Copy the Client ID (ends in .apps.googleusercontent.com) here.
#    No client secret is needed. Restart the server afterwards.
GOOGLE_CLIENT_ID=

# --- GitHub API --------------------------------------------------------------
# Optional but recommended: raises the GitHub API rate limit from 60/hr
# to 5,000/hr. Create a fine-grained personal access token (no scopes
# needed for public repos) at https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Server ------------------------------------------------------------------
PORT=5001
NODE_ENV=development

# --- Gemini: chat + AI-generated ER / System Flow diagrams -------------------------
# Key from https://aistudio.google.com/apikey . The Database tab asks Gemini to
# write a small Python (graphviz) script per diagram; the server checks it and
# runs it in a sandbox, so Python 3 must be installed (or set PYTHON_BIN).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# PYTHON_BIN=python3

# --- Chat agent / Sentry (optional) ---------------------------------------------
# Max characters of repository source code sent to Gemini with each chat
# question (~4 chars per token). Default 400000 (~100k tokens). Raise it for bigger repos, lower it if you hit Gemini rate limits.
# CHAT_CODE_CHAR_BUDGET=400000
# Override the Sentry DSN (a default is built into instrument.js).
# SENTRY_DSN=

# --- Production / HTTPS (see ../DEPLOY.md) ---
# NODE_ENV=production      -> requires JWT_SECRET, redirects http->https, enables HSTS,
#                             turns off the /api/setup screen and open CORS
# JWT_SECRET=<48+ random bytes as hex>
# TRUST_PROXY=1            -> number of reverse proxies in front of Node (default 1 in production)
# CORS_ORIGIN=             -> only if the frontend is hosted on a different origin
# ALLOW_SETUP=true         -> re-enable the Settings/setup endpoints (not recommended publicly)
# FORCE_HTTPS=false        -> disable the http->https redirect (e.g. TLS handled upstream without X-Forwarded-Proto)
